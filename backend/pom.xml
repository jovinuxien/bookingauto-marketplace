<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.3.5</version>
    <relativePath/>
  </parent>

  <groupId>se.marketplace</groupId>
  <artifactId>backend</artifactId>
  <version>0.1.0</version>
  <name>booking-marketplace-backend</name>
  <description>One backend behind both frontends. Modules divide by domain, not by audience.</description>

  <properties>
    <java.version>21</java.version>
    <spring-modulith.version>1.2.4</spring-modulith.version>

    <!-- Default true so the ordinary build stays fast. The frontend is built
         explicitly, with -Dskip.npm=false, when a deployable jar is wanted. -->
    <skip.npm>true</skip.npm>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>

    <!-- JDBC, not JPA. The search query is deliberately hand-written SQL:
         it uses PostGIS functions an ORM would only get in the way of, and
         the query plan is something we will want to read. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
    </dependency>

    <!-- The console is the first surface with a person behind it. Adding this
         makes everything deny-by-default, which is the right posture and means
         the public endpoints now have to be listed on purpose. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>

    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!-- Enforces the module boundaries at build time, so splitting a module
         out later is a deployment change rather than a rewrite. -->
    <dependency>
      <groupId>org.springframework.modulith</groupId>
      <artifactId>spring-modulith-starter-core</artifactId>
    </dependency>

    <!-- Money. Pinned to a stable release, not the newest beta: this is the
         one dependency where a surprise costs a customer rather than a build. -->
    <dependency>
      <groupId>com.stripe</groupId>
      <artifactId>stripe-java</artifactId>
      <version>29.2.0</version>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.modulith</groupId>
      <artifactId>spring-modulith-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.modulith</groupId>
        <artifactId>spring-modulith-bom</artifactId>
        <version>${spring-modulith.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>

      <!--
        Builds the SPA into target/classes/static, so the jar is the whole
        deployable: one artefact, one origin, no CORS, and no second deployment
        that can drift out of step with the API it depends on.

        Skipped with -Dskip.npm=true, which every backend-only build should use.
        Node is downloaded rather than assumed, so a build machine needs nothing
        installed beyond a JDK.
      -->
      <plugin>
        <groupId>com.github.eirslett</groupId>
        <artifactId>frontend-maven-plugin</artifactId>
        <version>1.15.1</version>
        <configuration>
          <nodeVersion>v20.16.0</nodeVersion>
          <npmVersion>10.8.1</npmVersion>
          <installDirectory>target</installDirectory>
          <skip>${skip.npm}</skip>
        </configuration>
        <executions>
          <execution>
            <id>install-node-and-npm</id>
            <goals><goal>install-node-and-npm</goal></goals>
            <phase>generate-resources</phase>
          </execution>
          <execution>
            <id>npm-install</id>
            <goals><goal>npm</goal></goals>
            <phase>generate-resources</phase>
            <configuration><arguments>install --no-audit --no-fund</arguments></configuration>
          </execution>
          <execution>
            <id>npm-build</id>
            <goals><goal>npm</goal></goals>
            <phase>prepare-package</phase>
            <configuration><arguments>run build</arguments></configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

</project>
