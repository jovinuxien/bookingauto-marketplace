# Copy to .env and fill in.  cp .env.sample .env && set -a && . ./.env && set +a

CAL_DB_PASSWORD=change-me
MARKET_DB_PASSWORD=change-me

# Cal requires both. Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=change-me
CALENDSO_ENCRYPTION_KEY=change-me

# Where the sync service listens for Cal webhooks
SYNC_PORT=8000
SYNC_WEBHOOK_SECRET=change-me

# Free-text search (/api/search/ask). Both are needed: without the key the
# agent platform is not even loaded, and without the flag it is loaded and
# unused. Off by default because it is billed per search.
MARKETPLACE_AI_ENABLED=false
ANTHROPIC_API_KEY=
